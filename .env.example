POSTGRES_DB=bugboard_db
POSTGRES_USER=bugboard
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# JWT signing secret (HS256). Must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_value_at_least_32_bytes

# Admin user created at startup (DataSeeder)
SEED_USERNAME=bugboard
SEED_EMAIL=bugboard@bugboard.it
SEED_PASSWORD=bugboard

azure.storage.connection-string=DefaultEndpointsProtocol=https;AccountName=bugboard26;AccountKey=...
azure.storage.container-name=attachments