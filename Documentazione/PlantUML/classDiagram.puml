@startuml
' --- Configurazione Stile ---
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle

' --- CONTROLLER LAYER ---
package "Controller Layer (Interface)" {

    class AuthController {
        - userService: UserService
        + login(request: LoginDTO): ResponseEntity
    }
    
    class ProjectController {
        - projectService: ProjectService
        + getProjects(): ResponseEntity
    }
    
    class IssueController {
        - issueService: IssueService
        + createIssue(request: IssueDTO): ResponseEntity
    }

    class ReportController {
        - reportService: ReportService
        + generateReport(projectId: int): ResponseEntity
    }

    class LabelController {
        - labelService: LabelService
        + createLabel(request: LabelDTO): ResponseEntity
    }

    class AttachmentController {
        - attachmentService: AttachmentService
        + uploadAttachment(issueId: int, file: MultipartFile): ResponseEntity
    }


}

' --- SERVICE LAYER ---
package "Service Layer (Business Logic)" {

    class UserService {
        - userRepository: UserRepository
    }
    
    class ProjectService {
        - projectRepository: ProjectRepository
    }
    
    class IssueService {
        - issueRepository: IssueRepository
        - labelRepository: LabelRepository
    }

    class ReportService {
        - reportRepository: ReportRepository
    }

    class LabelService {
        - labelRepository: LabelRepository
    }

    class AttachmentService {
        - attachmentRepository: AttachmentRepository
    }

}

' --- REPOSITORY LAYER ---
package "Repository Layer (Data Access)" {
    interface JpaRepository <<Spring Data Base>> {
    }

    interface UserRepository <<interface>>
    interface ProjectRepository <<interface>>
    interface IssueRepository <<interface>>
    interface LabelRepository <<interface>>
    interface AttachmentRepository <<interface>>
}

' --- ENTITY LAYER ---
package "Entity Layer (Data Model)" {
    class User {
        - id: Integer
        - username: String
        - email: String
        - passwordHash: String
        - role: RoleEnum
    }

    class Project {
        - id: Integer
        - name: String
        - description: String
        - createdAt: Timestamp
    }

    class Issue {
        - id: Integer
        - title: String
        - description: String
        - status: StatusEnum
        - priority: PriorityEnum
        - type: TypeEnum
    }

    class Label {
        - id: Integer
        - name: String
        - color: String
    }

    class Attachment {
        - id: Integer
        - filePath: String
        - fileName: String
        - fileSize: Integer
    }

    class Report {
        - id: Integer
        - openedBugs: Integer
        - managedBugs: Integer
        - averageResolutionTime: Double
    }

    class MonthlyReport extends Report {
        - referenceMonth: Integer
        - referenceYear: Integer
    }

    class UserMonthlyReport extends MonthlyReport {
        - userId: Integer
        - userName: String
    }

    class ProjectMonthlyReport extends MonthlyReport {
        - projectId: Integer
    }
}

' ===========================================
' DTO LAYER (Data Transfer Objects)
' TODO: ADD RELATIONS WITH OTHER LAYERS
' ===========================================

package "DTO Layer (Data Transfer Objects)" {
    class LoginDTO {
        - email: String
        - password: String
    }

    class RegisterDTO {
        - username: String
        - email: String
        - password: String
        - role : RoleEnum
    }

    class IssueDTO {
        - projectId: Integer
        - title: String
        - description: String
        - status: StatusEnum
        - priority: PriorityEnum
        - type: TypeEnum
        - attachmentIds: List<Integer>
        - assignedToUserId: Integer
    }

    ' ==================================
    'TODO: SISTEMARE QUESTO DTO
    class LabelDTO { 
        - name: String
        - color: String
    }
    ' ==================================


    class AttachmentDTO {
        - issueId: Integer
        - filePath: String
        - fileName: String
        - fileExtension: String
        - fileSize: Integer
    }
}

' ==========================================
' RELAZIONI TRA I LIVELLI (Top-Down)
' ==========================================

' Controllers usano Services
AuthController --> UserService : usa
ProjectController --> ProjectService : usa
IssueController --> IssueService : usa
AttachmentController --> AttachmentService : usa
LabelController --> LabelService : usa
ReportController --> ReportService : usa

' Services usano Repositories
UserService --> UserRepository : usa
ProjectService --> ProjectRepository : usa
IssueService --> IssueRepository : usa
IssueService --> LabelRepository : usa
AttachmentService --> AttachmentRepository : usa

' Repositories estendono JpaRepository
JpaRepository <|-- UserRepository
JpaRepository <|-- ProjectRepository
JpaRepository <|-- IssueRepository
JpaRepository <|-- LabelRepository
JpaRepository <|-- AttachmentRepository

' Repositories gestiscono Entities
UserRepository --> User : gestisce
ProjectRepository --> Project : gestisce
IssueRepository --> Issue : gestisce
LabelRepository --> Label : gestisce
AttachmentRepository --> Attachment : gestisce


' ==========================================
' RELAZIONI TRA LE ENTITÀ (Database)
' ==========================================

' User <-> Project (Molti a Molti)
User "*" -- "*" Project : partecipa

' Project <-> Issue (1 a Molti)
Project "1" *-- "*" Issue : contiene

' User <-> Issue (1 a Molti, x2)
User "1" -- "*" Issue : reportedBy >
User "1" -- "*" Issue : assignedTo >

' Project <-> Label (1 a Molti)
Project "1" *-- "*" Label : definisce

' Label <-> Issue (Molti a Molti)
Label "*" -- "*" Issue : associata >

' Issue <-> Attachment (1 a Molti)
Issue "1" *-- "*" Attachment : contiene

@enduml