@startuml CD-BugBoard26
skinparam linetype ortho
interface IUtente {
    +getId(): int
    +login(): boolean
    +logout(): void
}

class Utente implements IUtente {
    -id: int
    -email: String
    -passwordHash: String

    +getWorkLoad(): int
    +reportIssue(i: Issue): void
    +editIssue(i: IIssue): void

}

class Admin extends Utente {
    +createUser(): Utente
    +assignIssue(u: IUtente, i: IIssue): void
}


interface IIssue {
    +getDetails(): String
    +setAssignee(u: IUtente): void
    +setReporter(u: IUtente): void
    +changeStatus(newStatus: String): void
    +addLabel(label: String): void
    +removeLabel(label: String): void
}

class Issue implements IIssue {
    -id: int
    -title: String
    -description: String
    -creationDate: DateTime
    -priority: String
    -attachment: File
    -status: String
    -labels: List<String>
    -reporter: Utente
    -assignee: Utente

    +getDetails(): String
    +setAssignee(u: IUtente): void
    +setReporter(u: IUtente): void
    +changeStatus(newStatus: String): void
    +addLabel(label: String): void
    +removeLabel(label: String): void
}

Utente "0..1"--"*" Issue : "assigned to"
Utente "1"--"*" Issue : "reports"
@enduml