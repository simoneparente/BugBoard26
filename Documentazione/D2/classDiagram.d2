# --- Configurazione Stile e Layout ---
direction: down
vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 200
  }
}

# Definizione di stile globale per le classi
classes: {
  style: {
    border-radius: 4
    shadow: true
  }
}

# ===========================================
# CONTROLLER LAYER
# ===========================================
ctrl: Controller Layer (Interface) {
  style: { fill: transparent; stroke-width: 2 }

  auth: AuthController {
    shape: class
    - userService: UserService
    + login(request: LoginDTO): ResponseEntity
  }
  
  proj: ProjectController {
    shape: class
    - projectService: ProjectService
    + getProjects(): ResponseEntity
  }
  
  issue: IssueController {
    shape: class
    - issueService: IssueService
    + createIssue(request: IssueDTO): ResponseEntity
  }

  report: ReportController {
    shape: class
    - reportService: ReportService
    + generateReport(projectId: int): ResponseEntity
  }

  tag: TagController {
    shape: class
    - tagService: TagService
    + createTag(request: TagDTO): ResponseEntity
  }

  attach: AttachmentController {
    shape: class
    - attachmentService: AttachmentService
    + uploadAttachment(issueId: int, file: MultipartFile): ResponseEntity
  }
}

# ===========================================
# SERVICE LAYER
# ===========================================
srv: Service Layer (Business Logic) {
  style: { fill: transparent; stroke-width: 2 }

  user: UserService {
    shape: class
    - userRepository: UserRepository
  }
  
  proj: ProjectService {
    shape: class
    - projectRepository: ProjectRepository
  }
  
  issue: IssueService {
    shape: class
    - issueRepository: IssueRepository
    - tagRepository: TagRepository
  }

  report: ReportService {
    shape: class
    - reportRepository: ReportRepository
  }

  tag: TagService {
    shape: class
    - tagRepository: TagRepository
  }

  attach: AttachmentService {
    shape: class
    - attachmentRepository: AttachmentRepository
  }
}

# ===========================================
# REPOSITORY LAYER
# ===========================================
repo: Repository Layer (Data Access) {
  style: { fill: transparent; stroke-width: 2 }

  jpa: {
    shape: class
    label: "<<Spring Data Base>>\nJpaRepository"
  }

  user: { shape: class; label: "<<interface>>\nUserRepository" }
  proj: { shape: class; label: "<<interface>>\nProjectRepository" }
  issue: { shape: class; label: "<<interface>>\nIssueRepository" }
  tag: { shape: class; label: "<<interface>>\nTagRepository" }
  attach: { shape: class; label: "<<interface>>\nAttachmentRepository" }
}

# ===========================================
# ENTITY LAYER
# ===========================================
ent: Entity Layer (Data Model) {
  style: { fill: transparent; stroke-width: 2 }

  user: User {
    shape: class
    - id: Integer
    - username: String
    - email: String
    - passwordHash: String
    - role: RoleEnum
  }

  proj: Project {
    shape: class
    - id: Integer
    - name: String
    - description: String
    - createdAt: Timestamp
    - issues: List<Issue>
    - members: List<User>
    - tags: List<Tag>
  }

  issue: Issue {
    shape: class
    - id: Integer
    - title: String
    - description: String
    - status: StatusEnum
    - priority: PriorityEnum
    - type: TypeEnum
    - createdAt: Timestamp
    - updatedAt: Timestamp
    - assignedTo: User
    - attachments: List<Attachment>
    - tags: List<Tag>
  }

  tag: Tag {
    shape: class
    - id: Integer
    - name: String
    - color: String
  }

  attach: Attachment {
    shape: class
    - id: Integer
    - filePath: String
    - fileName: String
    - fileSize: Integer
    - fileExtension: String
  }

  proj_rep: ProjectReport {
    shape: class
    - id: Integer
    - project: Project
    - averageResolutionTime: Double
  }

  month_proj_rep: MonthlyProjectReport {
    shape: class
    - referenceMonth: Integer
    - referenceYear: Integer
  }

  user_month_rep: UserMonthlyProjectReport {
    shape: class
    - user: User
  }
}

# ===========================================
# DTO LAYER
# ===========================================
dto: DTO Layer (Data Transfer Objects) {
  style: { fill: transparent; stroke-width: 2 }

  login: LoginDTO {
    shape: class
    - email: String
    - password: String
  }

  register: RegisterDTO {
    shape: class
    - username: String
    - email: String
    - password: String
    - role: RoleEnum
  }

  issue: IssueDTO {
    shape: class
    - projectId: Integer
    - title: String
    - description: String
    - status: StatusEnum
    - priority: PriorityEnum
    - type: TypeEnum
    - attachmentIds: List<Integer>
    - assignedToUser: String
  }

  tag: TagDTO {
    shape: class
    - id: Integer
    - name: String
    - color: String
  }

  attach: AttachmentDTO {
    shape: class
    - issueId: Integer
    - filePath: String
    - fileName: String
    - fileExtension: String
    - fileSize: Integer
  }

  proj_month_rep: ProjectMonthlyReportDTO {
    shape: class
    - projectId: Integer
    - projectName: String
    - referenceMonth: Integer
    - referenceYear: Integer
    - openedBugs: Integer
    - managedBugs: Integer
    - averageResolutionTime: Double
    - userMonthlyReports: List<UserMonthlyReportMetricDTO>
  }

  user_month_rep_metric: UserMonthlyReportMetricDTO {
    shape: class
    - userId: Integer
    - userName: String
    - referenceMonth: Integer
    - referenceYear: Integer
    - openedBugs: Integer
    - managedBugs: Integer
    - averageResolutionTime: Double
  }
}

# ==========================================
# RELAZIONI TRA I LIVELLI (Top-Down)
# ==========================================

# Controllers usano Services
ctrl.auth -> srv.user: usa
ctrl.proj -> srv.proj: usa
ctrl.issue -> srv.issue: usa
ctrl.attach -> srv.attach: usa
ctrl.tag -> srv.tag: usa
ctrl.report -> srv.report: usa

# Services usano Repositories
srv.user -> repo.user: usa
srv.proj -> repo.proj: usa
srv.issue -> repo.issue: usa
srv.issue -> repo.tag: usa
srv.attach -> repo.attach: usa

# Repositories estendono JpaRepository (Inheritance)
repo.user -> repo.jpa: extends
repo.proj -> repo.jpa: extends
repo.issue -> repo.jpa: extends
repo.tag -> repo.jpa: extends
repo.attach -> repo.jpa: extends

# Repositories gestiscono Entities
repo.user -> ent.user: gestisce
repo.proj -> ent.proj: gestisce
repo.issue -> ent.issue: gestisce
repo.tag -> ent.tag: gestisce
repo.attach -> ent.attach: gestisce

# ==========================================
# RELAZIONI TRA LE ENTITÀ (Database)
# ==========================================

# User <-> Project (Molti a Molti)
ent.user -- ent.proj: "partecipa (* .. *)"

# Project <-> Issue (1 a Molti)
ent.proj -> ent.issue: "contiene (1 .. *)"

# User <-> Issue (1 a Molti, x2)
ent.user -> ent.issue: "reportedBy (1 .. *)"
ent.user -> ent.issue: "assignedTo (1 .. *)"

# Project <-> Tag (1 a Molti)
ent.proj -> ent.tag: "definisce (1 .. *)"

# Tag <-> Issue (Molti a Molti)
ent.tag -> ent.issue: "associata (* .. *)"

# Issue <-> Attachment (1 a Molti)
ent.issue -> ent.attach: "contiene (1 .. *)"

# Ereditarietà Report (Entity)
ent.month_proj_rep -> ent.proj_rep: extends
ent.user_month_rep -> ent.month_proj_rep: extends

# ==========================================
# RELAZIONE ENTITY - SERVICES (Business Logic)
# ==========================================
srv.report -> ent.month_proj_rep: genera
srv.report -> ent.user_month_rep: genera